{
  "manifest_version": 3,
  "name": "Stagecraft Task Notifier",
  "version": "1.0.0",
  "description": "Get notified instantly when new unclaimed tasks appear on Stagecraft (feather.openai.com)",
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://feather.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://feather.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://feather.openai.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stagecraft Task Notifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
