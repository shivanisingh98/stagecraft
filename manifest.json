{
  "manifest_version": 3,
  "name": "Stagecraft – Task Claimer",
  "version": "2.0.0",
  "description": "One click to claim the first available task in the Available Work tab on feather.openai.com",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://feather.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://feather.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claim first available task",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
